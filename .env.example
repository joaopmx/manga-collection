# Copie este arquivo para .env e ajuste os valores.

# PostgreSQL (ex.: Neon, https://neon.tech). Use as duas connection strings do mesmo banco:
# a "pooled" (host com "-pooler"), usada pelo app...
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require"
# ...e a "direct" (sem "-pooler"), usada pelas migrações do Prisma.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require"

# Segredo usado para assinar as sessões de login. Gere um valor próprio, por exemplo:
#   npx auth secret
AUTH_SECRET="troque-por-uma-string-aleatoria"
